# ---- API server ----
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- PostgreSQL (financial source of truth) ----
PG_HOST=localhost
PG_PORT=5433
